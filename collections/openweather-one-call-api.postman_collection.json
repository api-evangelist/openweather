  "info": {
    "_postman_id": "ca080ace-9a60-4c23-b00a-2f603c83cdd4",
    "name": "OpenWeather and Air Pollution One Call API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Programmatic access to the OpenWeather One Call API for current, minute, hourly, and daily forecasts plus government weather alerts, and the OpenWeather Air Pollution API for current, forecast, and historical air quality data including the Air Quality Index and pollutant concentrations.\n\nContact Support:\n Name: OpenWeather",
      "type": "text/plain"
    }
